!/writable/.htaccess
!/writable/index.html
!/writable/cache/
/writable/cache/*
!/writable/cache/index.html
!/writable/logs/
/writable/logs/*
!/writable/logs/index.html
!/writable/session/
/writable/session/*
!/writable/session/index.html
!/writable/uploads/
/writable/uploads/*
!/writable/uploads/index.html

# User-generated production content
/public/uploads/

# Test results, caches, coverage, and generated reports
/.phpunit.cache/
.phpunit.result.cache
/coverage/
/output/
/tmp/
/testsprite_tests/
/.gstack/

